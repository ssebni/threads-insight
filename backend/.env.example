# Absolute path to the service account JSON. Never paste its contents here.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
FIRESTORE_DATABASE_ID=(default)
THREADS_ACCESS_TOKEN=
THREADS_AUTO_SYNC=false
THREADS_SYNC_INTERVAL_SECONDS=60
THREADS_INSIGHT_INTERVAL_SECONDS=900
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Codyssey-issued key using the Anthropic Messages protocol.
# AI_PROVIDER can be codyssey_anthropic or openai.
# If omitted, a non-empty CODESEI_API_KEY selects Codyssey automatically.
AI_PROVIDER=
CODESEI_API_KEY=
CODESEI_BASE_URL=https://copa.codyssey.kr
CODESEI_MODEL=claude-sonnet-4
# Required on Render. Enter this value in the frontend access dialog, never in public config.js.
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
THREADS_ACCOUNT_CREATED_DATE=2026-10-03
